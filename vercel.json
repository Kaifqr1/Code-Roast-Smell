{
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/code-roast run build",
  "outputDirectory": "dist/public",
  "framework": null,
  "functions": {
    "api/roast.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/roast",
      "destination": "/api/roast"
    }
  ]
}
